class Solution(object):
    def isValid(self, s):
        stack = []

        if (len(s)) % 2 == 1:
            return False
        
        for x in range(len(s)):
            s_sub = s[x:(x+1)]
            if s_sub in {"{","[","("}:
                stack.append(s_sub)
            else:
                if not stack:
                    return False

                opening = stack.pop()
                if ((s_sub  == ")" ) and (opening == "(")) or ((s_sub  =="}" ) and (opening =="{")) or ((s_sub  == "]" ) and (opening =="[")):
                    next
                else:
                    return False
        if not stack:
            return True
        else:
            return False
    

                